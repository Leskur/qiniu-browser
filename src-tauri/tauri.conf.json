{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "qiniu-browser",
  "version": "0.0.1",
  "identifier": "com.leskur.qiniu-browser",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Qiniu Browser",
        "width": 1024,
        "height": 768,
        "minWidth": 900,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {},
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "deb",
      "appimage",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "updater": {
      "dialog": true,
      "pubkey": "",
      "endpoints": [
        "https://github.com/Leskur/qiniu-browser/releases/latest/download/latest.json"
      ],
      "active": false
    }
  }
}
