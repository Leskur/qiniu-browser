{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Qiniu Browser",
  "version": "0.0.3",
  "identifier": "com.leskur.qiniu-browser",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Qiniu Browser",
        "width": 1200,
        "height": 750,
        "minWidth": 1080,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE1M0NEODdBQ0M1QUVGNjMKUldSajcxck1ldGc4cFhqSUwvVVl2Q1hoQ21vQVV1b0RmQ3VBeXM4Q2duek9haEtKOFAvajJGOEQK",
      "endpoints": [
        "https://github.com/Leskur/qiniu-browser/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "deb",
      "appimage",
      "dmg"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
